# ═══════════ বিদ্যুৎ মনিটর — ক্রন (Vercel Cron-এর বদলে) ═══════════
# ইনস্টল:  crontab server/bijli-cron      (অথবা sudo cp server/bijli-cron /etc/cron.d/bijli)
#
# ⚠️ সময়: স্ক্রিপ্ট ভেতরে বাংলাদেশ সময় (UTC+6) হিসাব করে, কিন্তু ক্রনের ট্রিগার
#    সার্ভারের টাইমজোনে চলে। সার্ভার UTC হলে নিচের সময় ঠিক (06:00 UTC = 12:00 BD)।
#    যাচাই:  timedatectl | grep "Time zone"

# প্রতি ৫ মিনিটে — ব্রাউজার বন্ধ থাকলেও বিদ্যুৎ যাওয়া/আসা, লোড, ফাল্ট, খরচ অ্যালার্ট
*/5 * * * * curl -fsS http://127.0.0.1:8000/api/check_alert >/dev/null 2>&1

# দৈনিক রিপোর্ট — 06:00 UTC = দুপুর ১২:০০ (বাংলাদেশ)
0 6 * * * curl -fsS http://127.0.0.1:8000/api/daily_report >/dev/null 2>&1

# মাসিক রিপোর্ট — প্রতি মাসের ১ তারিখ 06:00 UTC = দুপুর ১২:০০ (বাংলাদেশ)
0 6 1 * * curl -fsS http://127.0.0.1:8000/api/monthly_report >/dev/null 2>&1